#!/usr/bin/env bash

case $1 in
    "+"*)
        brightnessctl s "${1:1}%+"
        ;;
    "-"*)
        brightnessctl s "${1:1}%-"
        ;;
    *)
        echo "Usage: backlightctl [+-]{brightness}"
        exit 1
        ;;
esac

brightness=$(brightnessctl g)
brightness_max=$(brightnessctl m)
brightness_perc=$(($brightness * 100 / $brightness_max))
notify-send -r 10001 -i brightnesssettings -h int:value:$brightness_perc "Brightness: $brightness_perc%"

